# Copy to .env and set your token (never commit .env).
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Prompt compression before image gen (optional).
# https://thetokencompany.com/docs
THETOKENCOMPANY_API_KEY=

# 3D conversion — Stability AI Stable Fast 3D (image → textured GLB).
# https://platform.stability.ai/docs/api-reference#tag/3D/paths/~1v2beta~13d~1stable-fast-3d/post
STABILITY_API_KEY=

# Optional tuning (multipart form fields):
# STABILITY_SF3D_TEXTURE_RESOLUTION=1024
# STABILITY_SF3D_FOREGROUND_RATIO=0.85
# STABILITY_SF3D_REMESH=none
