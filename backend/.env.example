# Copy to .env and set your token (never commit .env).
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Prompt compression before image gen (optional).
# https://thetokencompany.com/docs
THETOKENCOMPANY_API_KEY=

# Required for 3D conversion (Hunyuan3D uses HF ZeroGPU; anonymous calls are rejected).
# Also accepted: HUGGINGFACE_HUB_TOKEN, or run: huggingface-cli login on the backend host.
# https://huggingface.co/settings/tokens
HF_TOKEN=
